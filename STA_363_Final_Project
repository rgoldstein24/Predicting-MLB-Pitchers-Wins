#### KNN

```{r}
#### Import Data for KNN
MLB3 <- read_csv("MLB.csv")
MLB3 <- MLB3[,-1] #remove player name as it is not of interest

## Convert to categorical variables
MLB3$Team <- as.factor(MLB3$Team)
```

```{r}
#### Build the KNN Model

knnGower <- function(trainX, testX, trainY, K){
  
  if(nrow(testX)==1){
    # Convert the data
    dataAll <- rbind(testX,trainX)
    trainX <- model.matrix(1:nrow(dataAll)~ ., data = dataAll)[-1,-1]
    testX <- model.matrix(1:nrow(dataAll)~ ., data = dataAll)[1,-1]
  } else{
    trainX <- model.matrix(1:nrow(trainX)~ ., data = trainX)[,-1]
    testX <- model.matrix(1:nrow(testX)~ ., data = testX)[,-1]
  }
  
  if(class(testX)=="numeric"){
    testX <- t(data.frame(testX))
  }
  
  # Find the Gower Distance
  gowerHold <- StatMatch::gower.dist( testX, trainX)
  # For each row, find the k smallest
  neighbors <- apply(gowerHold, 1, function(x) which(x %in% sort(x)[1:K]))
  
  if(class(neighbors)[1]=="integer"){
    preds <- trainY[neighbors]
  }
  
  # Take the mean to get the prediction
  if(class(neighbors)[1]=="matrix"){
    preds <- apply(neighbors, 2,function(x) mean(trainY[x]))
  }
  
  if(class(neighbors)[1]=="list"){
    preds <- lapply(neighbors, function(x) mean(trainY[x]))
    preds <- unlist(preds)
  }
  # Return the predictions
  unlist(preds)
}
```


```{r}
# Create a storage space to hold the value of K and the
# validation RMSE for that choice of K

bestK <- data.frame("k"=1:30, "RMSE"=rep("NA",30))

# Outer Loop
for( k in 1:30){

  # Create a storage space to hold the predictions from 
  # LOOCV
  
  YHatKnn <- data.frame("Wins" = rep(NA,nrow(MLB3)))

  # Inner Loop
  for( f in 1:nrow(MLB3)){ 

    # Step 2
    # Take the f row and store them as validation data
    validation <- MLB3[f,]
    # Take the rest of the rows and store them as training data
    training <- MLB3[-f,]
    
    # Step 3
    # Build the k-NN on the training data set
    model <- knnGower(training, validation, training$W, K = k)

    # Step 4
    YHatKnn[f, ] <- model

  }
  bestK[k,2] <- round(compute_RMSE(MLB3$W, YHatKnn$Wins),4)
}
```

